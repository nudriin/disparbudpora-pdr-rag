# ============================================================
# ENVIRONMENT VARIABLES - Chatbot Pariwisata Palangka Raya
# ============================================================
# Salin file ini menjadi .env.local dan isi nilainya.
# JANGAN pernah commit .env.local ke git!
# Di Google Cloud Run, semua variabel ini diset via Secret Manager
# atau Environment Variables di halaman konfigurasi Cloud Run.
# ============================================================

# --- Google AI (Gemini) ---
# Dapatkan dari: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# --- Supabase (Auth & Data Relasional) ---
# Dapatkan dari: Dashboard Supabase > Project Settings > API
# Supabase HANYA digunakan untuk: auth admin, history percakapan,
# metadata dokumen, dan log ingesti. BUKAN untuk vector store.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- Admin Panel Auth ---
# Rahasia untuk menandatangani JWT session admin panel
# Generate dengan: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ADMIN_JWT_SECRET=your_very_long_random_secret_here_min_64_chars

# --- ChromaDB (Vector Store) ---
# ChromaDB untuk Node.js berjalan sebagai HTTP server (bukan embedded seperti Python).
#
# Untuk development lokal (cara termudah, tidak perlu Docker):
#   pip install chromadb
#   chroma run --path ./chroma_db --port 8000
#
# Jika punya folder chroma_db dari proyek Python yang sudah ada:
#   chroma run --path D:\path\ke\chroma_db --port 8000
#
# Untuk production, ChromaDB di-deploy sebagai service terpisah di GCP.
# Lihat docs/DEPLOY_CLOUD_RUN.md untuk instruksi lengkap.
CHROMA_URL=http://[::1]:8000
# Path folder penyimpanan data ChromaDB (digunakan oleh ChromaDB server, bukan app ini)
# CHROMA_PATH=./chroma_db

# --- Telegram Bot ---
# Dapatkan dari: @BotFather di Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# --- Google Cloud Run ---
# Diisi secara otomatis oleh Cloud Run, atau isi manual untuk testing.
# Format: https://nama-service-hash-region.a.run.app
NEXT_PUBLIC_APP_URL=https://your-cloud-run-url.a.run.app

# --- Port (diatur otomatis oleh Cloud Run, default 8080) ---
PORT=8080

